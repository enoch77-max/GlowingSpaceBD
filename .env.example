# ============================================================================
# FRONTEND PUBLIC ENV (.env) — Bundled into client JS. Safe public values ONLY.
# ============================================================================
# Public site URL (used for canonical, OG, JSON-LD)
VITE_SITE_URL=https://glowingspace.com.bd

# Public customer WhatsApp support number in international format, no +
VITE_WHATSAPP_NUMBER=8801700000000

# Optional backend API origin for Admin RBAC & Write-Only Secrets Vault
# Leave blank in frontend-only MVP mode.
VITE_ADMIN_API_URL=

# ============================================================================
# SECURITY NOTE: NEVER place bKash, Nagad, Steadfast, Pathao, SMS OTP, or JWT
# secrets in this file or with a VITE_ prefix. Manage those exclusively via
# the Backend Secrets Vault (/admin/secrets -> server KMS / .env.server).
# ============================================================================
