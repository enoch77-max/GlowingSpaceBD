# ==============================================================================
# Glowing Space BD — Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# 1. PostgreSQL Database URL
# Default points to a local PostgreSQL instance (or docker-compose up -d)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 2. Public Storefront URLs & Contacts (Optional, defaults provided in code)
NEXT_PUBLIC_SITE_URL=https://glowingspace.com.bd
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000

# 3. External Backend API (Optional - leave blank to use built-in Next.js App Router API)
# NEXT_PUBLIC_ADMIN_API_URL=
